# Virtual environment
.venv/

# Python
__pycache__/
*.pyc

# Environment variables / secrets
.env

# Data (read-only raw sources + derived data) — keep directory structure
data/*
!data/**/.gitkeep

# Submission dataset: splits + the original source CSV ARE tracked.
# data/raw/, data/processed/, data/external/ stay ignored via the data/* rule above.
!data/splits/
!data/epiclim_Final_data.csv

